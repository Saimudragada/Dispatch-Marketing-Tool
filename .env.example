# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Postgres (Supabase) — Settings > Database > Connection string
DATABASE_URL=            # Transaction pooler connection (port 6543), used at runtime
DIRECT_URL=              # Session pooler connection (port 5432), used for Prisma schema pushes

# Anthropic
ANTHROPIC_API_KEY=       # Server-only, used in API routes only
